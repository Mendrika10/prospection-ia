# =============================================================================
# Prospection IA - variables d'environnement (EXEMPLE)
# Copier en .env puis renseigner les vraies valeurs. NE JAMAIS COMMITER .env.
# Réf. cahier des charges §7.6
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase - Dashboard (Public par conception, protégé par RLS)
# Utilisé par : apps/dashboard (et le CLI Supabase)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# Supabase - n8n UNIQUEMENT
# Contourne la RLS. Ne JAMAIS exposer au front, ne JAMAIS commiter.
# À stocker dans les credentials n8n (ou dans n8n/.env, ignoré par Git).
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# Google PageSpeed Insights (WF3) - clé gratuite, sans carte bancaire
# -----------------------------------------------------------------------------
PSI_API_KEY=

# -----------------------------------------------------------------------------
# Google Places (WF2, optionnel - carte bancaire requise)
# -----------------------------------------------------------------------------
GOOGLE_PLACES_KEY=

# -----------------------------------------------------------------------------
# Notifications (WF4) - Telegram recommandé (gratuit, sans CB)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack (alternative) : URL du webhook entrant
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# n8n (docker-compose local)
# Générer une clé : openssl rand -hex 32
# -----------------------------------------------------------------------------
# ⚠️ N8N_BASIC_AUTH_* n'existe plus (supprimé depuis n8n 1.0) : au premier démarrage,
# n8n demande de créer le compte propriétaire (email + mot de passe) dans l'UI.
N8N_ENCRYPTION_KEY=change-me-with-openssl-rand-hex-32
N8N_HOST=localhost
N8N_PORT=5678
GENERIC_TIMEZONE=Indian/Antananarivo
